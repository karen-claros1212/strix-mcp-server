# Strix MCP Server — Environment Variables
# Copy to .env and adjust values

# ── Strix connection ─────────────────────────────────────────────
# Path to Strix repository (relative or absolute)
STRIX_REPO=./strix

# Sandbox ToolServer URL (empty = local execution only)
STRIX_SANDBOX_TOOL_SERVER_URL=

# Bearer token for sandbox authentication
STRIX_SANDBOX_TOKEN=

# Agent ID for sandbox requests
STRIX_SANDBOX_AGENT_ID=default

# ── Security ─────────────────────────────────────────────────────
# Comma-separated list of tools to expose (overrides default allowlist)
# Default: only read-only / analysis tools
# Examples:
#   STRIX_MCP_ALLOWED_TOOLS=think,list_files,search_files
#   STRIX_MCP_ALLOWED_TOOLS=  (empty = use default)
STRIX_MCP_ALLOWED_TOOLS=

# Force-blocked tools that can be overridden
# Default blocked: terminal_execute, python_action, browser_action, str_replace_editor, send_request
# Examples:
#   STRIX_MCP_FORCE_BLOCKED_TOOLS=terminal_execute,browser_action
STRIX_MCP_FORCE_BLOCKED_TOOLS=

# ── Rate limiting ────────────────────────────────────────────────
STRIX_MCP_RATE_LIMIT_MAX=30
STRIX_MCP_RATE_LIMIT_WINDOW=60

# ── Logging ──────────────────────────────────────────────────────
STRIX_MCP_LOG_LEVEL=INFO
